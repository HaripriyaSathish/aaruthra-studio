# Aaruthra Studio — environment variables
#
# Copy this file to `.env` in the project root and fill in real values.
# `.env` is git-ignored; only this example file is committed.
# The Django backend (backend/studio_backend/settings.py) loads `.env`
# automatically on startup — no manual export needed.

# --- Django core ---
# Generate a real secret for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
# Comma-separated list of allowed hostnames, e.g. api.aaruthrastudio.com,localhost
DJANGO_ALLOWED_HOSTS=*

# --- Database ---
# Leave unset to use zero-config SQLite (backend/db.sqlite3).
# Set to a real URL to use PostgreSQL/MySQL instead, e.g.:
#   DATABASE_URL=postgres://user:password@localhost:5432/aaruthra_db
# DATABASE_URL=

# --- Startup automation ---
# When True, the backend automatically runs `migrate` and seeds sample
# studio data on every startup — no need to run migrate/createsuperuser
# by hand. Set to False once you manage migrations yourself.
AUTO_MIGRATE=True
AUTO_SEED=True

# --- CORS ---
# True allows any origin to call the API (fine for local dev / demos).
CORS_ALLOW_ALL_ORIGINS=True
# Comma-separated exact origins to allow when CORS_ALLOW_ALL_ORIGINS=False,
# e.g. https://aaruthrastudio.com,https://www.aaruthrastudio.com
CORS_ALLOWED_ORIGINS=

# --- Cloudinary (optional, used by the Admin Panel's photo upload) ---
CLOUDINARY_CLOUD_NAME=cikqryjt
CLOUDINARY_API_KEY=682344329152784
CLOUDINARY_API_SECRET=rBKPO1BrPevbZt-sTLQhdpALwAE

# --- Optional: auto-create a Django admin superuser on first startup ---
# Set all three to have `python manage.py createsuperuser` handled for you.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@aaruthrastudio.com
# DJANGO_SUPERUSER_PASSWORD=change-me